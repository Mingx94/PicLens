{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-portable-release",
      "displayName": "Linux portable Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-portable-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICLENS_SYSTEM_PACKAGE": "OFF",
        "PICLENS_USE_SYSTEM_QT": "OFF",
        "PICLENS_REQUIRE_BUNDLED_LICENSES": "ON"
      }
    },
    {
      "name": "linux-deb-release",
      "displayName": "Linux DEB Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-deb-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICLENS_SYSTEM_PACKAGE": "ON",
        "PICLENS_USE_SYSTEM_QT": "OFF",
        "PICLENS_REQUIRE_BUNDLED_LICENSES": "ON"
      }
    },
    {
      "name": "fedora-rpm-release",
      "displayName": "Fedora RPM Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/fedora-rpm-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICLENS_SYSTEM_PACKAGE": "ON",
        "PICLENS_USE_SYSTEM_QT": "ON",
        "PICLENS_REQUIRE_BUNDLED_LICENSES": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "linux-portable-release",
      "configurePreset": "linux-portable-release"
    },
    {
      "name": "linux-deb-release",
      "configurePreset": "linux-deb-release"
    },
    {
      "name": "fedora-rpm-release",
      "configurePreset": "fedora-rpm-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-portable-release",
      "configurePreset": "linux-portable-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-deb-release",
      "configurePreset": "linux-deb-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fedora-rpm-release",
      "configurePreset": "fedora-rpm-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
