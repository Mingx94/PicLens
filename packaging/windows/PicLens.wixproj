<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <SuppressPdbOutput>true</SuppressPdbOutput>
    <!-- ProgramMenuFolder and HKMU follow the same selected install context, but ICE57 does not evaluate ALLUSERS redirection. -->
    <SuppressIces>ICE57</SuppressIces>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>AppVersion=$(AppVersion);PayloadDir=$(PayloadDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
