<Application x:Class="PicLens.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
<ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/SelectionControls.xaml"/></ResourceDictionary.MergedDictionaries>
<SolidColorBrush x:Key="Surface" Color="#F6F5F1"/><SolidColorBrush x:Key="Card" Color="#FFFFFF"/><SolidColorBrush x:Key="Ink" Color="#243333"/><SolidColorBrush x:Key="MutedInk" Color="#687471"/><SolidColorBrush x:Key="Line" Color="#DDDFD8"/><SolidColorBrush x:Key="Accent" Color="#245F51"/><SolidColorBrush x:Key="Selected" Color="#E1EDE7"/>
<Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft JhengHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
<Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="560"/></Style>
</ResourceDictionary></Application.Resources></Application>
