<Window x:Class="PicLens.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PicLens.App" xmlns:controls="clr-namespace:PicLens.App.Controls" Style="{StaticResource {x:Type Window}}" Title="PicLens" Width="1600" Height="1000" MinWidth="800" MinHeight="600" Icon="AppIcon.ico" PreviewKeyDown="WindowKeyDown" PreviewMouseDown="WindowMouseDown" PreviewMouseUp="WindowMouseUp" Closing="WindowClosing" SizeChanged="WindowSizeChanged">
<Window.Resources><BooleanToVisibilityConverter x:Key="Bool"/>
<HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" ToolTip="{Binding Path}"><controls:LucideIcon Kind="Folder" Margin="4,0,4,0"/><TextBlock Text="{Binding Name}" Margin="4,7" TextTrimming="CharacterEllipsis"/></StackPanel></HierarchicalDataTemplate>
<Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="IsExpanded" Value="False"/><EventSetter Event="Expanded" Handler="FolderExpanded"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style>
</Window.Resources>
<Grid Background="{DynamicResource Surface}">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,16">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:LucideIcon Kind="Images" Width="28" Height="28" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="PicLens" FontSize="23" FontWeight="SemiBold"/></StackPanel>
<TextBlock x:Name="HeaderTitle" Grid.Column="1" Text="{Binding FolderName}" FontSize="15" VerticalAlignment="Center" Margin="28,0" TextTrimming="CharacterEllipsis"/>
<Button Grid.Column="2" Click="ChooseFolder" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" AutomationProperties.Name="選擇資料夾"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="FolderOpen" Margin="0,0,8,0"/><TextBlock Text="選擇資料夾" VerticalAlignment="Center"/></StackPanel></Button>
</Grid></Border>
<Grid Grid.Row="1" x:Name="Workspace">
<Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="Sidebar" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="14,20">
<DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="資料夾" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedInk}" Margin="8,0,0,16"/><Button Content="{Binding RootPath}" ToolTip="{Binding RootPath}" Click="RootClicked" HorizontalContentAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="根資料夾（固定展開）"/></StackPanel>
<TreeView x:Name="FolderTree" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" SelectedItemChanged="TreeSelected" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
</DockPanel></Border>
<Grid Grid.Column="1" Margin="24,20,24,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Click="ToggleSidebar" ToolTip="顯示／隱藏側欄" AutomationProperties.Name="切換側欄"><controls:LucideIcon Kind="PanelLeft"/></Button><Button Click="BackClicked" ToolTip="上一個資料夾" AutomationProperties.Name="上一個資料夾"><controls:LucideIcon Kind="ArrowLeft"/></Button><Button Click="ForwardClicked" ToolTip="下一個資料夾" AutomationProperties.Name="下一個資料夾"><controls:LucideIcon Kind="ArrowRight"/></Button><Button Click="RefreshClicked" ToolTip="重新整理 (F5)" AutomationProperties.Name="重新整理"><controls:LucideIcon Kind="RefreshCw"/></Button></StackPanel><TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource MutedInk}" ToolTip="{Binding Folder}"/></DockPanel>
<WrapPanel Grid.Row="1" Margin="0,16,0,14"><Grid Width="280" Margin="0,0,12,8"><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="38,9,36,9" ToolTip="搜尋名稱或路徑 (Ctrl+F)" AutomationProperties.Name="搜尋圖片"/><controls:LucideIcon Kind="Search" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource MutedInk}"/><TextBlock Text="搜尋名稱或路徑…" Margin="38,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button HorizontalAlignment="Right" Padding="8,0" Margin="0" BorderThickness="0" Click="ClearSearch" ToolTip="清除搜尋" AutomationProperties.Name="清除搜尋"><controls:LucideIcon Kind="X"/><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid>
<ComboBox SelectedIndex="{Binding SortIndex}" Width="158" Margin="0,0,10,8" AutomationProperties.Name="排序"><ComboBoxItem Content="名稱：由小到大"/><ComboBoxItem Content="名稱：由大到小"/><ComboBoxItem Content="修改時間：最舊"/><ComboBoxItem Content="修改時間：最新"/></ComboBox>
<CheckBox Content="含子資料夾" IsChecked="{Binding Recursive}" Margin="0,0,14,8"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center"><TextBlock Text="縮圖" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center"/><Slider Width="100" Minimum="120" Maximum="240" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding ThumbnailSize}" Margin="8,0" AutomationProperties.Name="縮圖大小"/></StackPanel>
</WrapPanel>
<WrapPanel Grid.Row="2" Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="ConvertJpeg" AutomationProperties.Name="轉為 JPG"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Image" Margin="0,0,8,0"/><TextBlock Text="轉為 JPG" VerticalAlignment="Center"/></StackPanel></Button><Button Click="ConvertWebp" AutomationProperties.Name="無損 WebP"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Image" Margin="0,0,8,0"/><TextBlock Text="無損 WebP" VerticalAlignment="Center"/></StackPanel></Button><Button Click="CleanupClicked" AutomationProperties.Name="同名清理"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Trash2" Margin="0,0,8,0"/><TextBlock Text="同名清理" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Count, StringFormat={}{0:N0} 個項目}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionText}" Foreground="{DynamicResource MutedInk}" Margin="14,0"/></StackPanel></WrapPanel>
<Grid Grid.Row="3">
<ListBox SelectionMode="Multiple" SelectionChanged="GallerySelectionChanged" x:Name="Gallery" ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AllowDrop="True" DragOver="GalleryDragOver" Drop="GalleryDrop" DragLeave="GalleryDragLeave">
<ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingTilePanel TileWidth="{Binding TileWidth}" TileHeight="{Binding TileHeight}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="IsSelected" Value="{Binding Selected, Mode=OneWay}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Border x:Name="Tile" Margin="0,0,12,14" Padding="6" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Background="{DynamicResource Card}" Loaded="TileLoaded" Unloaded="TileUnloaded" DataContextChanged="TileContextChanged" PreviewMouseDown="TileMouseDown" PreviewMouseMove="TileMouseMove" ToolTip="{Binding Path}">
<Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border CornerRadius="5" Background="{DynamicResource Surface}" ClipToBounds="True"><Grid><controls:LucideIcon Kind="{Binding PlaceholderIcon}" Width="46" Height="46" Foreground="{DynamicResource MutedInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Image}" Stretch="UniformToFill"/><controls:LucideIcon Kind="CircleAlert" Foreground="{DynamicResource Ink}" Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"><controls:LucideIcon.Style><Style TargetType="controls:LucideIcon"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:LucideIcon.Style></controls:LucideIcon></Grid></Border>
<TextBlock x:Name="TileName" Foreground="{DynamicResource Ink}" Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="5,9,5,3" FontWeight="SemiBold"/><TextBlock x:Name="TileDetail" Grid.Row="2" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="5,0,5,1"/>
</Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Selected}"/><Setter TargetName="TileName" Property="Foreground" Value="{DynamicResource SelectedInk}"/><Setter TargetName="TileDetail" Property="Foreground" Value="{DynamicResource SelectedInk}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><controls:LucideIcon Kind="Images" Width="64" Height="64" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="留一點空間，給你的圖片。" FontSize="24" Margin="0,18,0,8"/><TextBlock Text="選擇本機資料夾，或調整搜尋條件。" HorizontalAlignment="Center" Foreground="{DynamicResource MutedInk}"/></StackPanel>
</Grid></Grid></Grid>
<Grid x:Name="ViewerLayer" Grid.Row="1" Background="#141617" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="18,14">
<StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Click="CloseViewer" AutomationProperties.Name="← 返回圖庫"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="ArrowLeft" Margin="0,0,8,0"/><TextBlock Text="返回圖庫" VerticalAlignment="Center"/></StackPanel></Button><Button Click="PreviousImage" ToolTip="上一張圖片" AutomationProperties.Name="上一張圖片"><controls:LucideIcon Kind="ChevronLeft"/></Button><Button Click="NextImage" ToolTip="下一張圖片" AutomationProperties.Name="下一張圖片"><controls:LucideIcon Kind="ChevronRight"/></Button></StackPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="ZoomOut" ToolTip="縮小" AutomationProperties.Name="縮小"><controls:LucideIcon Kind="Minus"/></Button><Button x:Name="ZoomButton" Content="100%" Click="ResetZoom" ToolTip="重設縮放"/><Button Click="ZoomIn" ToolTip="放大" AutomationProperties.Name="放大"><controls:LucideIcon Kind="Plus"/></Button><Button Click="RevealViewer" AutomationProperties.Name="在檔案總管顯示"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="FolderOpen" Margin="0,0,8,0"/><TextBlock Text="在檔案總管顯示" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
<TextBlock x:Name="ViewerInfo" Foreground="#B6C1BB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0"/>
</DockPanel><controls:ViewerCanvas x:Name="Canvas" Grid.Row="1" Focusable="True" ClipToBounds="True"/>
</Grid>
<Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Card}" Padding="24,10"><StackPanel>
<DockPanel Margin="0,0,0,10"><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding SettingsSaveError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
<Button DockPanel.Dock="Right" Content="重試儲存設定" Click="RetrySettingsSave" Margin="16,0,0,0"/>
<TextBlock Text="{Binding SettingsSaveError}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
</DockPanel>
<DockPanel><Button x:Name="CancelBatchButton" DockPanel.Dock="Right" Content="取消工作" Click="CancelBatch" Visibility="Collapsed" MinHeight="26" Padding="10,3"/><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
</StackPanel></Border>
<Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Padding="18" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed" MaxWidth="600"><StackPanel><TextBlock x:Name="ToastMessage" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button Content="查看逐項結果" Click="ShowResults"/><Button Content="關閉" Click="DismissToast"/></StackPanel></StackPanel></Border>
<Border x:Name="DragHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" Padding="18" Background="{DynamicResource Accent}" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="DragHintText" Foreground="White"/></Border>
</Grid></Window>
